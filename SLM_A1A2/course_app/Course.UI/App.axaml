<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="using:Avalonia.Themes.Fluent" x:Class="Course.UI.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <fluent:FluentTheme>
      <fluent:FluentTheme.Palettes><fluent:ColorPaletteResources x:Key="Light" Accent="#216957" /></fluent:FluentTheme.Palettes>
    </fluent:FluentTheme>
    <Style Selector="Window">
      <Setter Property="Background" Value="#F5F6F3" />
      <Setter Property="Foreground" Value="#213B41" />
      <Setter Property="FontFamily" Value="Segoe UI, Noto Sans, sans-serif" />
    </Style>
    <Style Selector="TextBlock"><Setter Property="FontSize" Value="15" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#667A7F" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="Foreground" Value="#5D787A" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="1.6" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="18" /><Setter Property="Padding" Value="24" /><Setter Property="BorderBrush" Value="#E2E8E4" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="46" /><Setter Property="Padding" Value="18,11" /><Setter Property="CornerRadius" Value="10" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Background" Value="#EBEFEB" /><Setter Property="Foreground" Value="#234A49" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#216957" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#185240" /><Setter Property="TextBlock.Foreground" Value="White" /></Style>
    <Style Selector="Button.secondary"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#D4DFD9" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="8,10" /></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#E2ECE5" /><Setter Property="Padding" Value="18,13" /></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#29474A" /><Setter Property="TextBlock.Foreground" Value="White" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="48" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="13,11" /><Setter Property="Background" Value="#FAFCFA" /><Setter Property="BorderBrush" Value="#CFDBD3" /><Setter Property="FontSize" Value="16" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="48" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12,10" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Background" Value="#FAFCFA" /></Style>
    <Style Selector="ProgressBar"><Setter Property="Foreground" Value="#3A876B" /><Setter Property="Background" Value="#E7EDE7" /><Setter Property="Height" Value="5" /><Setter Property="MinHeight" Value="5" /><Setter Property="CornerRadius" Value="3" /><Setter Property="ClipToBounds" Value="True" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="MinHeight" Value="52" /><Setter Property="Padding" Value="14,12" /><Setter Property="Margin" Value="0,3" /><Setter Property="CornerRadius" Value="10" /></Style>
  </Application.Styles>
</Application>
