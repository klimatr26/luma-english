<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Avalonia.Themes.Fluent"
             x:Class="WritingApp.UI.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <theme:FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#F7F7F2" />
      <Setter Property="FontFamily" Value="Segoe UI, Noto Sans, sans-serif" />
      <Setter Property="Foreground" Value="#183A37" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
  </Application.Styles>
</Application>
