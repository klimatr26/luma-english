<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WritingApp.Shared/WritingApp.Shared.csproj" />
    <ProjectReference Include="../WritingApp.Native/WritingApp.Native.csproj" />
    <Content Include="$(WritingNativeRoot)/win-x64/*.dll" Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(WritingNativeRoot)/win-x64/writing_worker.exe" Link="writing_worker.exe"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
